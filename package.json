{
  "name": "devicecloud-mcp",
  "version": "0.1.4",
  "mcpName": "io.github.RubenGlez/devicecloud",
  "description": "MCP server for DeviceCloud — query Maestro test uploads, results, analytics, and artifacts from any MCP-compatible AI assistant",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "devicecloud",
    "maestro",
    "testing",
    "mobile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RubenGlez/devicecloud-mcp.git"
  },
  "homepage": "https://github.com/RubenGlez/devicecloud-mcp#readme",
  "bugs": {
    "url": "https://github.com/RubenGlez/devicecloud-mcp/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "devicecloud-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepare": "tsc",
    "test": "node --import tsx/esm --test src/index.test.ts",
    "release": "node scripts/release.mjs",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
